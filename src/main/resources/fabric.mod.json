{
	"schemaVersion": 1,
	"id": "illuminated",
	"version": "${version}",
	"name": "Illuminated",
	"description": "Illuminate your world with a flashlight!",
	"authors": [
		{
			"name":"Akarys",
			"contact": {
				"email": "ambre@akarys.me"
			}
		},
		{
			"name":"LambdAurora",
			"contact": {
				"homepage": "https://lambdaurora.dev",
				"email": "email@lambdaurora.dev"
			}
		}
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/illuminated",
		"sources": "https://github.com/LambdAurora/Illuminated",
		"issues": "https://github.com/LambdAurora/Illuminated/issues"
	},
	"license": "Lambda License",
	"icon": "assets/illuminated/textures/item/flashlight.png",
	"environment": "*",
	"entrypoints": {
		"yumi:client_init": [
			"dev.lambdaurora.illuminated.client.IlluminatedClient::INSTANCE"
		],
		"yumi:init": [
			"dev.lambdaurora.illuminated.Illuminated"
		],
		"lambdynlights:initializer": [
			"dev.lambdaurora.illuminated.client.IlluminatedClient::INSTANCE"
		]
	},
	"accessWidener": "illuminated.accesswidener",
	"mixins": [
		"illuminated.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"fabric-api": ">=0.154.0+26.2",
		"minecraft": "~26.2-",
		"java": ">=25",
		"yumi_mc_core": ">=1.1.1",
		"lambdynlights": "^4.12.0"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/illuminated",
				"modmenu.discord": "https://discord.lambdaurora.dev/",
				"modmenu.github_releases": "https://github.com/LambdAurora/Illuminated/releases",
				"modmenu.modrinth": "https://modrinth.com/mod/illuminated"
			}
		}
	}
}
